{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end tests against the Dockerised restaurant stack",
  "scripts": {
    "stack:up": "docker compose -f ../docker-compose.e2e.yml up -d --build --wait",
    "stack:down": "docker compose -f ../docker-compose.e2e.yml down -v",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "e2e": "npm run stack:up && (npm run test; rc=$?; npm run stack:down; exit $rc)"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
